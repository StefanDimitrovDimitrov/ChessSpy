# Copy to .env and fill in.

# "groq" (free cloud tier) or "ollama" (local, free)
MODEL_PROVIDER=groq

# Groq: free key, no credit card -> https://console.groq.com/keys
GROQ_API_KEY=

# Optional model override. Defaults: groq -> llama-3.3-70b-versatile, ollama -> qwen3:8b
# MODEL_ID=

# Required before you expose the app through a Cloudflare tunnel.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OS_SECURITY_KEY=

# Agno sends an anonymous event per run (no prompts or outputs). Turn off if you like.
AGNO_TELEMETRY=false
